# Google OAuth Client ID
# Steps to get this:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project (or select existing)
# 3. Enable the Gmail API:
#    APIs & Services → Enable APIs → search "Gmail API" → Enable
# 4. Create OAuth credentials:
#    APIs & Services → Credentials → Create Credentials → OAuth client ID
#    Application type: Web application
#    Authorized JavaScript origins: http://localhost:3000 (and your production URL)
#    Authorized redirect URIs: http://localhost:3000 (and your production URL)
# 5. Copy the Client ID below

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id-here.apps.googleusercontent.com

# ─── AI Provider API Keys (optional — app works in mock mode without these) ────
# Keys are baked in at build time via NEXT_PUBLIC_ prefix.
# For production, use a backend proxy instead of exposing keys client-side.

# OpenAI — https://platform.openai.com/api-keys
NEXT_PUBLIC_OPENAI_API_KEY=sk-...

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
NEXT_PUBLIC_ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek — https://platform.deepseek.com/api_keys
NEXT_PUBLIC_DEEPSEEK_API_KEY=sk-...
